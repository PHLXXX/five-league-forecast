NODE_ENV=production
PORT=5177
HOST=0.0.0.0

# Optional but recommended for richer live data.
FOOTBALL_DATA_API_KEY=
ODDS_API_KEY=
PINNACLE_GUEST_API_KEY=

# Optional persistent directory for saved pre-match records and market cache.
# On Render, point this at a mounted persistent disk (for example /var/data).
DATA_DIR=

# Public API protection. Increase only after moving behind stronger hosting limits.
ANALYZE_RATE_LIMIT=120
RATE_LIMIT_WINDOW_MS=900000
